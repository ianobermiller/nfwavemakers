{
  "name": "nfwm-ballots",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "convex dev --start vite",
    "dev:frontend": "vite",
    "dev:prod": "node --env-file=.env --env-file=.env.local scripts/dev-prod.mjs",
    "build": "tsc && vite build",
    "types": "tsc",
    "lint": "oxlint src convex --ignore-pattern '**/_generated/**'",
    "format": "oxfmt src convex",
    "knip": "knip",
    "check": "run-p --print-label types lint knip",
    "check:push": "run-p --print-label types lint knip test:e2e",
    "test:e2e": "playwright test",
    "seed:test": "node --env-file=.env --env-file=.env.local scripts/seed-test-accounts.mjs",
    "migrate:instant": "node --env-file=.env --env-file=.env.local scripts/migrate-from-instant.mjs",
    "migrate:instant:prod": "npm run migrate:instant -- --prod"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.6.30",
    "@convex-dev/better-auth": "^0.12.5",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-popover": "^1.1.17",
    "better-auth": "^1.6.30",
    "cnfast": "^0.0.8",
    "convex": "^1.45.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "knip": "^6.14.2",
    "npm-run-all2": "^8.0.4",
    "oxfmt": "^0.51.0",
    "oxlint": "^0.16.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
