{
  "name": "nfwm-ballots",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "oxlint && vite build",
    "types": "tsc",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt src e2e scripts",
    "knip": "knip",
    "check": "run-p --print-label types lint knip",
    "check:push": "run-p --print-label types lint knip test:e2e",
    "test:e2e": "playwright test",
    "seed:test": "node --env-file=.env --env-file=.env.local scripts/seed-test-accounts.mjs",
    "pages:deploy": "npm run build && wrangler pages deploy dist --project-name nfwm-ballots"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-popover": "^1.1.17",
    "cnfast": "^0.0.8",
    "pocketbase": "^0.28.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "knip": "^6.14.2",
    "npm-run-all2": "^8.0.4",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tailwindcss": "^4.3.0",
    "typescript": "^7.0.2",
    "vite": "^6.0.3",
    "wrangler": "^4.129.0"
  }
}
