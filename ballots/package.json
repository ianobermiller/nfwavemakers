{
  "name": "nfwm-ballots",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "types": "tsc",
    "lint": "oxlint src",
    "format": "oxfmt src",
    "knip": "knip",
    "check": "run-p --print-label types lint knip",
    "check:push": "run-p --print-label types lint knip test:e2e",
    "test:e2e": "playwright test",
    "token": "node scripts/get-token.mjs"
  },
  "dependencies": {
    "@instantdb/react": "^1.0.39",
    "@radix-ui/react-dialog": "^1.1.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@instantdb/admin": "^1.0.39",
    "@instantdb/platform": "^1.0.39",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "knip": "^6.14.2",
    "npm-run-all2": "^8.0.4",
    "oxfmt": "^0.51.0",
    "oxlint": "^0.16.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
